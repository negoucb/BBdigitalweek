<script>

let modoEdicao = false;

function toggleModoEdicao(){

    modoEdicao = !modoEdicao;

    const tabela = document.querySelector(".table-body");

    if(modoEdicao){
        tabela.classList.add("modo-edicao");
    } else {
        tabela.classList.remove("modo-edicao");
    }

}

  /*formulário*/
  function abrirFormulario(){

    const tabela = document.getElementById("tabela-area");

    const formulario = document.getElementById("formulario-area");


    const formularioVisivel =
    window.getComputedStyle(formulario).display !== "none";


    if(formularioVisivel){

        formulario.style.display = "none";

        tabela.style.display = "block";

    } else {

        tabela.style.display = "none";

        formulario.style.display = "block";

    }

}
/**/
function toggleFiltros(){

    const filtros =
    document.getElementById("filtersBar");

    filtros.classList.toggle("active");

}
/**/
function voltarTabela(){

    document.getElementById("tabela-area").style.display = "block";

    document.getElementById("formulario-area").style.display = "none";

}

  /*menu*/
function toggleMenu() {
  document.getElementById("dropdownMenu").classList.toggle("show");
}

// Fecha o menu se clicar fora
window.onclick = function(event) {
  if (!event.target.closest('.dropdown')) {
    document.getElementById("dropdownMenu").classList.remove("show");
  }
}

const rows = document.querySelectorAll(".table-row");

rows.forEach(row => {

    row.addEventListener("click", () => {

        const details = row.querySelector(".details");

        const isVisible = window.getComputedStyle(details).display !== "none";

        if(isVisible){
            details.style.display = "none";
        } else {
            details.style.display = "grid";
        }

    });

});
</script>



