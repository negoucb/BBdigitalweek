/*filtro*/
.filters-bar{
    display: none;

    grid-template-columns: repeat(5, 1fr);

    gap: 16px;

    background: #f56d93;

    padding: 24px;

    border-radius: 30px 30px 0 0;

    margin-bottom: -10px;

    animation: aparecer 0.2s ease;
    
}

.filters-bar input,
.filters-bar select{
    padding: 14px;

    border: none;

    border-radius: 12px;

    font-size: 14px;

    outline: none;
}

.filters-bar.active{
    display: grid;
}
@keyframes aparecer{

    from{
        opacity: 0;
        transform: translateY(-10px);
    }

    to{
        opacity: 1;
        transform: translateY(0);
    }

}
/* Tabela do cronograma*/


.wrapper {
  width: 100%;
  max-width: 1160px;
  margin-top: 2cm;
  position: absolute;
  right: 9cm;
   
}

.table-container {
  border-radius: 16px;
  overflow: visible;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}

.tablem{
  align-items: center;
  
}


.table-header {
  display: grid;
  grid-template-columns: 56px 1fr 1.4fr 0.9fr 1.2fr 1fr;
  align-items: center;
  background: linear-gradient(90deg, #4f5af0 0%, #5b6aff 100%);
  padding: 0;
  min-height: 72px;
 border-radius: 10px 10px 0 0;
}

.table-header .filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8688a;
  width: 2cm;
  height: 100%;
  min-height: 72px;
  border-radius: 0 0 32px 0;
  cursor: pointer;
  transition: background 0.2s;
  flex-shrink: 0;
   border-top-left-radius: 10px;
}

.table-header .filter-btn:hover {
  background: #f56d93;
}

.table-header .col {
  color: #ffffff;
  font-size: 1rem;
  font-weight: 700;
  text-align: center;
  padding: 18px 12px;
  letter-spacing: 0.02em;
  
  
}


.table-body {
  background: #ffffff;
  max-height: 500px;
    overflow-y: auto;
}


.table-row {
  display: grid;
  grid-template-columns: 56px 1fr 1.4fr 0.9fr 1.2fr 1fr;
  align-items: center;
  min-height: 64px;
  border-bottom: 1px solid #e8eaf0;
  transition: background 0.15s;
  
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.alt {
  background: #f7f8fc;
}

.table-row:hover {
  background: #eef0ff;
}


.cell {
  padding: 14px 16px;
  font-size: 0.875rem;
  color: #2d2f45;
  text-align: center;
  line-height: 1.4;
}

/* First cell in row – spacer to align with filter button */
.cell.time {
  font-weight: 600;
  font-size: 0.82rem;
  color: #3a3d5c;
  grid-column: 2; /* skip first column spacer */
}



.cell.status {
  font-weight: 700;
  font-size: 0.82rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.cell.status.verificado {
  color: #1db87a;
}

.cell.status.andamento {
  color: #e6a817;
}

.cell.status.conflito {
  color: #e04545;
}

.cell.status .arrow {
  font-size: 0.75rem;
  opacity: 0.7;
}


@media (max-width: 768px) {
  .table-header
  .table-row {
    grid-template-columns: 1fr;
     display: flex;
    flex-wrap: wrap;
  }

  .table-header .filter-btn {
    display: none;
  }

  .table-header .col {
    display: none;
  }

  .table-header .col:first-of-type {
    display: block;
  }

  .cell {
    text-align: left;
    padding: 8px 16px;
  }

  .table-row {
    padding: 10px 0;
     display: flex;
    flex-wrap: wrap;
  }
}

